    <outline text="Tech" title="Tech">
      <outline type="rss" text="The Example Show" title="The Example Show" xmlUrl="https://example.test/feed.xml" htmlUrl="https://example.test/show"/>
      <outline type="rss" text="Atom Cast" xmlurl="HTTPS://Example.TEST/atom.xml#frag"/>
    </outline>
    <outline type="rss" text="Duplicate" xmlUrl="https://example.test/feed.xml"/>
    <outline type="rss" text="Bad scheme" xmlUrl="javascript:alert(1)"/>
