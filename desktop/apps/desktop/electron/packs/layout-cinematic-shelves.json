{
  "format": "beebo-pack",
  "v": 1,
  "kind": "layout",
  "id": "beebo.cinematic-shelves",
  "name": "Cinematic shelves",
  "version": "1.0.0",
  "description": "Roomy and immersive: floating poster cards, rounded corners, trailers up front and a slide-out sidebar.",
  "author": { "name": "Beebo Entertainment" },
  "license": "CC0-1.0",
