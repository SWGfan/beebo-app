<?xml version="1.0" encoding="utf-8"?>
<!--
  Google TV / Android TV global search. Results come from voice/TvSearchProvider.kt; each row
  carries its own beebo:// link, opened by voice/VoiceSearchActivity.kt.
  The authority must match AndroidManifest.xml (applicationId + ".tvsearch").
-->
<searchable xmlns:android="http://schemas.android.com/apk/res/android"
    android:label="@string/app_name"
    android:hint="@string/voice_search_hint"
    android:searchSuggestAuthority="com.beeboentertainment.movie.tvsearch"
    android:searchSuggestIntentAction="android.intent.action.VIEW"
    android:searchSuggestSelection=" ?"
    android:searchSuggestThreshold="2"
    android:includeInGlobalSearch="true"
    android:voiceSearchMode="showVoiceSearchButton|launchRecognizer" />
