# npm supply-chain policy for the Xbox app tooling (see docs/SUPPLY-CHAIN-SECURITY.md).
# Needs npm >= 11.17 (Node 24); older npm ignores these keys. Same rules as apps/smarttv/.npmrc.
# The one dependency (hls.js, Apache-2.0) has no install script, so none is allowed.
min-release-age=7
audit-level=high
strict-allow-scripts=true
