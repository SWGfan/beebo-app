    "density": "spacious",
    "cardStyle": "floating",
    "radius": 18,
    "posterAspect": "2:3",
    "fontScale": 1.05,
    "sidebar": { "mode": "hover", "order": [], "hidden": ["getapp", "suggest"] },
    "home": {
      "shelves": [
        { "id": "continue", "on": true },
        { "id": "trailers", "on": true },
        { "id": "recent", "on": true },
        { "id": "recommended", "on": true },
        { "id": "collections", "on": true },
        { "id": "watchlist", "on": true }
      ]
    }
  }
