<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android TV only (the "television" UI-mode qualifier). The player is a View layout whose
      buttons, and Media3's own transport controls, draw D-pad focus with the theme's control
      highlight. The stock one is a faint grey that disappears across a room, so on a TV it is
      the brand gold at about 45%. Everything else must match values/themes.xml.
    -->
    <style name="Theme.BeeboEntertainment" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="colorAccent">@color/brand</item>
        <item name="colorControlHighlight">@color/tv_focus_highlight</item>
        <item name="android:colorControlHighlight">@color/tv_focus_highlight</item>
    </style>

    <style name="Theme.BeeboEntertainment.Player" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="colorAccent">@color/brand</item>
        <item name="colorControlHighlight">@color/tv_focus_highlight</item>
        <item name="android:colorControlHighlight">@color/tv_focus_highlight</item>
    </style>
</resources>
