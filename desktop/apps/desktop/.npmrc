# npm supply-chain policy for the desktop app (see docs/SUPPLY-CHAIN-SECURITY.md).
# Needs npm >= 11.17 (Node 24). Older npm (Node 22 = npm 10) ignores these keys, so nothing
# gets weaker there; it just is not enforced.
#
# min-release-age: only install versions published at least 7 days ago (blunts a hijacked
#   release that is pulled within days). Applies when npm RESOLVES versions (npm install /
#   update); `npm ci` follows package-lock.json exactly.
# strict-allow-scripts: dependency install scripts (postinstall etc.) that are not on the
#   allow-list below FAIL the install instead of running silently, so a new or updated
#   package that adds an install script needs a human decision.
# audit-level: `npm audit` exits non-zero from this severity up.
min-release-age=7
audit-level=high
strict-allow-scripts=true
# Reviewed install scripts: electron (downloads its binary), esbuild (verifies its native
# binary), fsevents (macOS only, optional).
allow-scripts=electron,esbuild,fsevents
