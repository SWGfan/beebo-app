# npm supply-chain policy for the Roku channel tooling (see docs/SUPPLY-CHAIN-SECURITY.md).
# Needs npm >= 11.17 (Node 24); older npm ignores these keys. Details of each key are in
# desktop/apps/desktop/.npmrc.
min-release-age=7
audit-level=high
strict-allow-scripts=true
# fsevents is macOS only (optional dev dependency); it is the only install script here.
allow-scripts=fsevents
