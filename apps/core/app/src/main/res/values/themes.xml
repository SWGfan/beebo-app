<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The base theme is AppCompat-derived on purpose: androidx MediaRouteButton (the Cast button)
      inflates against AppCompat theme attributes and throws otherwise. Compose screens don't
      care what the XML theme is, so this costs us nothing.
    -->
    <style name="Theme.BeeboEntertainment" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="colorAccent">@color/brand</item>
    </style>

    <style name="Theme.BeeboEntertainment.Player" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="colorAccent">@color/brand</item>
    </style>
</resources>
