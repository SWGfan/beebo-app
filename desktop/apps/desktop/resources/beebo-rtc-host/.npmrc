# npm supply-chain policy for the rtc-host (see docs/SUPPLY-CHAIN-SECURITY.md).
# Needs npm >= 11.17 (Node 24); older npm ignores these keys. Details of each key are in
# desktop/apps/desktop/.npmrc. No dependency here has an install script, so none is allowed.
min-release-age=7
audit-level=high
strict-allow-scripts=true
